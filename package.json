    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.27.4",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
